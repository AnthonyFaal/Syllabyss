NODE_ENV=development
PORT=4000
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
BASE_URL=http://localhost:4000

# Brand and support contact shown in transactional emails.
APP_NAME=Syllabys
SUPPORT_EMAIL=admin@your-domain.example

# Use either Gmail or a custom SMTP provider.
EMAIL_FROM=admin@your-domain.example
EMAIL_PASS=your-email-provider-app-password
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=admin@your-domain.example
# SMTP_PASS=your-smtp-password

# Bound database failures so the API can return a useful error quickly.
DB_CONNECTION_TIMEOUT_MS=7000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX=10
